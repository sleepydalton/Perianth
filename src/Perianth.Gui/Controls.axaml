<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Two controls drawn here rather than adjusted where the toolkit draws them.

    Fluent derives a checked box from its own accent through brushes that the
    palette override does not reach, and its template part names are not
    recoverable from the shipped assembly — so tinting it meant guessing at
    internals, and the guesses were wrong twice. A template of our own is a few
    more lines and no guessing: it uses the palette directly, and it cannot
    drift when the toolkit reorganises its own.

    The same for the disclosure toggle. An expander brings a surface, a chevron
    and a header button, all of which had to be turned off; a button and a
    paragraph is what the thing actually is.
  -->

  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource AppText}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="9" Background="Transparent">
          <Border Name="Box"
                  Width="17" Height="17" CornerRadius="3"
                  VerticalAlignment="Center"
                  Background="Transparent"
                  BorderBrush="{DynamicResource AppBorder}"
                  BorderThickness="1.5">
            <Path Name="Tick"
                  Margin="3"
                  Stretch="Uniform"
                  IsVisible="False"
                  Data="M 0,5 L 4,9 L 12,0"
                  Stroke="{DynamicResource AppOnControlAccent}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round" />
          </Border>
          <ContentPresenter Content="{TemplateBinding Content}"
                            VerticalAlignment="Center"
                            FontSize="12" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource AppControlAccent}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource AppControlAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppControlAccent}" />
    </Style>
    <Style Selector="^:checked /template/ Path#Tick">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

  <!-- The "Details" toggle inside a note: a word that turns a paragraph on. -->
  <ControlTheme x:Key="DisclosureToggle" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Surface"
                Background="Transparent"
                CornerRadius="3"
                Padding="7,3">
          <ContentPresenter Content="{TemplateBinding Content}"
                            FontSize="11"
                            Foreground="{DynamicResource AppTextMuted}" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#Surface">
      <Setter Property="Background" Value="{DynamicResource AppSelection}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
