root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

# Correctness-flavoured rules, promoted to warnings so they fail the build.
dotnet_diagnostic.CA1305.severity = warning  # specify IFormatProvider
dotnet_diagnostic.CA1307.severity = warning  # specify StringComparison
dotnet_diagnostic.CA1309.severity = warning  # use ordinal StringComparison
dotnet_diagnostic.CA2007.severity = none     # ConfigureAwait: not a library concern here

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
